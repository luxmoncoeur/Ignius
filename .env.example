# ── PostgreSQL connection ──────────
# Option A · one connection string:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db_users

# Option B · individual variables (used when DATABASE_URL is not set):
PGHOST=localhost
PGPORT=5432
PGDATABASE=db_users
PGUSER=postgres
PGPASSWORD=postgres

# Copy this file to `.env.local` and adjust the password if yours is different.
# The website still works without a database — progress then lives in the
# browser (localStorage) as a guest.

# ── Sessions ──────────
SESSION_SECRET=change-me-to-a-long-random-string

# ── Cinder assistant (Groq) ──────────
# Without a key, Cinder still answers navigation, previews and calculations locally.
GROQ_API_KEY=
